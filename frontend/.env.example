# ── Frontend configuration (build-time; Vite inlines VITE_* vars) ──
# Copy to `.env` and adjust for your deployment.

# Base URL for the backend API.
# Leave EMPTY for same-origin (recommended behind a reverse proxy that serves
# the frontend and proxies /api to the backend). Set to a full origin only if
# the API lives on a different host, e.g. https://api.uniplanners.org
VITE_API_URL=

# Dev-only: target that `npm run dev` proxies /api to.
VITE_DEV_API_PROXY=http://localhost:3001
