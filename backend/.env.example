# ── Backend configuration ──
# Copy to `.env` and adjust. The scraper import scripts read this same file.

# HTTP port the API listens on
PORT=3001

# PostgreSQL connection (system Postgres, standard port 5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ozu_user
DB_PASSWORD=change-me
DB_NAME=ozu_schedule
DB_POOL_MAX=10

# Writable curriculum/elective storage. Local default: backend/data.
# Production deployment uses /var/lib/uniplanner/data.
# APP_DATA_DIR=/var/lib/uniplanner/data

# CPU-heavy worker threads. Default: min(CPU cores - 1, 4).
HEAVY_WORKERS=4
HEAVY_QUEUE_MAX=250

# Batched request logging. Every /api request is stored in server_request_logs.
LOG_FLUSH_MS=250
LOG_BATCH_SIZE=500
LOG_QUEUE_MAX=20000

# CORS: "*" allows any origin. For production set your site origin(s),
# comma-separated, including the panel origin in production.
# e.g. CORS_ORIGIN=https://uniplanner.org,https://www.uniplanner.org,https://panel.uniplanner.org
CORS_ORIGIN=*

# Set to 1 in production (HTTPS) so the session cookie gets the Secure flag.
COOKIE_SECURE=0

# Set to the number of trusted reverse-proxy hops in production (usually 1).
# Leave unset when exposing Node directly.
TRUST_PROXY=1

# Required before the protected analytics/admin endpoints are available.
ADMIN_SECRET=replace-with-a-long-random-secret
